{% doc %}
  Renders a progress bar towards the free shipping threshold set in theme settings.

  @example
  {% render 'free-shipping-bar' %}
{% enddoc %}
{%- if settings.free_shipping_threshold > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign progress = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
  -%}
  <div class="free-shipping{% if remaining <= 0 %} free-shipping--done{% endif %}">
    <p class="free-shipping__message">
      {%- if cart.item_count == 0 -%}
        {%- assign threshold_money = threshold | money_without_trailing_zeros -%}
        {{ 'sections.cart.free_shipping_goal_html' | t: amount: threshold_money }}
      {%- elsif remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ 'sections.cart.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'sections.cart.free_shipping_reached_html' | t }}
      {%- endif -%}
    </p>
    <div class="free-shipping__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}" aria-label="{{ 'sections.cart.free_shipping_label' | t }}">
      <span class="free-shipping__fill" style="width: {{ progress }}%;"></span>
    </div>
  </div>
{%- endif -%}
