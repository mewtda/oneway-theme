{% doc %}
  Outputs the WhatsApp chat URL from the theme settings, or nothing when no number is set.

  @example
  {% capture whatsapp_url %}{% render 'whatsapp-url' %}{% endcapture %}
{% enddoc %}
{%- liquid
  if settings.whatsapp_number != blank
    assign whatsapp_digits = settings.whatsapp_number | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '+' | remove: '.'
    assign whatsapp_url = 'https://wa.me/' | append: whatsapp_digits
    if settings.whatsapp_message != blank
      assign whatsapp_text = settings.whatsapp_message | url_encode
      assign whatsapp_url = whatsapp_url | append: '?text=' | append: whatsapp_text
    endif
    echo whatsapp_url
  endif
-%}
