{% doc %}
  Exposes global theme settings as CSS custom properties.

  @example
  {% render 'css-variables' %}
{% enddoc %}
{% style %}
  {{ settings.font_body | font_face: font_display: 'swap' }}
  {{ settings.font_body | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.font_body | font_modify: 'weight', '500' | font_face: font_display: 'swap' }}
  {{ settings.font_heading | font_face: font_display: 'swap' }}
  :root {
    --color-background: {{ settings.color_background }};
    --color-background-alt: {{ settings.color_background_alt }};
    --color-text: {{ settings.color_text }};
    --color-text-muted: {{ settings.color_text | color_modify: 'alpha', 0.6 }};
    --color-border: {{ settings.color_text | color_modify: 'alpha', 0.15 }};
    --color-accent: {{ settings.color_accent }};
    --color-accent-text: {{ settings.color_accent_text }};
    --color-sale: {{ settings.color_sale }};
    --color-announcement-bg: {{ settings.color_announcement_bg }};
    --color-announcement-text: {{ settings.color_announcement_text }};
    --color-footer-bg: {{ settings.color_footer_bg }};
    --color-footer-text: {{ settings.color_footer_text }};
    --color-footer-muted: {{ settings.color_footer_text | color_modify: 'alpha', 0.65 }};
    --color-footer-border: {{ settings.color_footer_text | color_modify: 'alpha', 0.2 }};
    --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
    --font-body-weight: {{ settings.font_body.weight }};
    --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
    --font-heading-weight: {{ settings.font_heading.weight }};
    --heading-transform: {% if settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    --heading-spacing: {{ settings.heading_letter_spacing | divided_by: 100.0 }}em;
    --page-width: {{ settings.page_width }}px;
    --page-gutter: clamp(1rem, 2.5vw, 2rem);
    --card-ratio: {{ settings.card_image_ratio }};
  }
{% endstyle %}
