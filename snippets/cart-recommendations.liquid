{% doc %}
  Renders complementary products for the cart: never the same product type as any item already in the cart.

  @param {number} [limit] - Maximum products to show, defaults to 4

  @example
  {% render 'cart-recommendations', limit: 4 %}
{% enddoc %}
{%- if cart.item_count > 0 -%}
  {%- liquid
    assign cart_types = ''
    assign cart_ids = ''
    for item in cart.items
      assign item_type = item.product.type | default: item.product.category.name
      assign cart_types = cart_types | append: item_type | append: '|'
      assign cart_ids = cart_ids | append: item.product_id | append: '|'
    endfor
    assign recs_limit = limit | default: 4
    capture cross_sell
      render 'cross-sell', exclude_types: cart_types, exclude_ids: cart_ids, limit: recs_limit, layout: 'compact'
    endcapture
  -%}
  {%- if cross_sell != blank -%}
    <div class="cart-recs">
      <p class="cart-recs__title">{{ 'sections.cart.recommendations' | t }}</p>
      <ul class="cart-recs__list">
        {{ cross_sell }}
      </ul>
    </div>
  {%- endif -%}
{%- endif -%}
