{% doc %}
  Renders complementary products for the cart: never the same product type as any item already in the cart.

  @param {number} [limit] - Maximum products to show, defaults to the cart_recs_limit theme setting

  @example
  {% render 'cart-recommendations', limit: 4 %}
{% enddoc %}
{%- assign recs_limit = limit | default: settings.cart_recs_limit -%}
{%- if recs_limit > 0 -%}
  {%- liquid
    assign cart_types = ''
    assign cart_ids = ''
    for item in cart.items
      assign item_type = item.product.type
      if item_type == blank
        assign item_type = item.product.title | downcase | replace: 'pré-venda', '' | replace: 'pre-venda', '' | strip | split: ' ' | first
      endif
      assign cart_types = cart_types | append: item_type | append: '|'
      assign cart_ids = cart_ids | append: item.product_id | append: '|'
    endfor
    capture cross_sell
      render 'cross-sell', exclude_types: cart_types, exclude_ids: cart_ids, limit: recs_limit, layout: 'compact', source: settings.cart_recs_collection
    endcapture
  -%}
  {%- if cross_sell != blank -%}
    <div class="cart-recs">
      <p class="cart-recs__title">{%- if settings.cart_recs_heading != blank -%}{{ settings.cart_recs_heading }}{%- else -%}{{ 'sections.cart.recommendations' | t }}{%- endif -%}</p>
      <ul class="cart-recs__list">
        {{ cross_sell }}
      </ul>
    </div>
  {%- endif -%}
{%- endif -%}
