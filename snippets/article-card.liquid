{% doc %}
  Renders a blog article card.

  @param {article} article - The article to render

  @example
  {% render 'article-card', article: article %}
{% enddoc %}
<article class="article-card">
  <a href="{{ article.url }}" class="article-card__media" tabindex="-1" aria-hidden="true">
    {%- if article.image -%}
      {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 33vw, 85vw', alt: article.image.alt }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </a>
  <p class="article-card__date">{{ article.published_at | time_tag: format: 'date' }}</p>
  <h3 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
  <p class="article-card__excerpt">
    {%- if article.excerpt != blank -%}
      {{ article.excerpt | strip_html | truncatewords: 24 }}
    {%- else -%}
      {{ article.content | strip_html | truncatewords: 24 }}
    {%- endif -%}
  </p>
  <a href="{{ article.url }}" class="link-underline article-card__more">{{ 'blogs.article.read_more' | t }}</a>
</article>
