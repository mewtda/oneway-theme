{% layout none %}
{%- assign initial_value = gift_card.initial_value | money -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_cards.issued.title' | t: value: initial_value }} &ndash; {{ shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    <main class="gift-card">
      <p class="site-header__logo-text">{{ shop.name }}</p>
      <h1 class="page-title">{{ 'gift_cards.issued.title' | t: value: initial_value }}</h1>
      {%- if gift_card.expired or gift_card.enabled == false -%}
        <p>{{ 'gift_cards.issued.expired' | t }}</p>
      {%- endif -%}
      <p class="gift-card__balance">{{ gift_card.balance | money }}</p>
      <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <a href="{{ shop.url }}" class="button">{{ 'gift_cards.issued.shop_link' | t }}</a>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}" class="link-underline">{{ 'gift_cards.issued.add_to_apple_wallet' | t }}</a>
      {%- endif -%}
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
