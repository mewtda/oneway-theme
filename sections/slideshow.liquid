<section class="slideshow slideshow--{{ section.settings.height }}" aria-roledescription="carousel" aria-label="{{ 'sections.slideshow.label' | t }}">
  <slide-show class="slideshow__track" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}">
    {%- for block in section.blocks -%}
      <div class="slideshow__slide{% if forloop.first %} is-active{% endif %} slideshow__slide--{{ block.settings.text_position }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}" {{ block.shopify_attributes }}>
        <div class="slideshow__media">
          {%- if block.settings.image -%}
            {%- assign loading = 'lazy' -%}
            {%- assign priority = 'auto' -%}
            {%- if forloop.first -%}
              {%- assign loading = 'eager' -%}
              {%- assign priority = 'high' -%}
            {%- endif -%}
            {{
              block.settings.image
              | image_url: width: 3000
              | image_tag:
                class: 'slideshow__image slideshow__image--desktop',
                widths: '750, 1100, 1500, 2000, 2500, 3000',
                sizes: '100vw',
                loading: loading,
                fetchpriority: priority
            }}
            {%- if block.settings.image_mobile -%}
              {{
                block.settings.image_mobile
                | image_url: width: 1200
                | image_tag:
                  class: 'slideshow__image slideshow__image--mobile',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '100vw',
                  loading: loading
              }}
            {%- endif -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'slideshow__image placeholder' }}
          {%- endif -%}
        </div>

        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="slideshow__overlay-link" tabindex="-1" aria-label="{{ block.settings.heading | escape }}"></a>
        {%- endif -%}

        <div class="slideshow__content page-width" style="--content-color: {{ block.settings.text_color }};">
          {%- if block.settings.heading != blank -%}
            <h2 class="slideshow__heading">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.subheading != blank -%}
            <p class="slideshow__subheading">{{ block.settings.subheading }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="button button--{{ block.settings.button_style }}">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}

    {%- if section.blocks.size > 1 -%}
      <div class="slideshow__controls page-width">
        <span class="slideshow__counter"><span data-slide-current>1</span> / {{ section.blocks.size }}</span>
        <button type="button" class="slideshow__arrow" data-slide-prev aria-label="{{ 'sections.slideshow.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
        <button type="button" class="slideshow__arrow" data-slide-next aria-label="{{ 'sections.slideshow.next' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
      </div>
    {%- endif -%}
  </slide-show>
</section>

{% schema %}
{
  "name": "Slideshow",
  "class": "section-slideshow",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Altura",
      "options": [
        { "value": "full", "label": "Tela cheia" },
        { "value": "large", "label": "Grande" },
        { "value": "medium", "label": "Média" }
      ],
      "default": "full"
    },
    { "type": "checkbox", "id": "autoplay", "label": "Troca automática", "default": true },
    { "type": "range", "id": "speed", "label": "Troca a cada", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagem mobile" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Coleção de inverno" },
        { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Peças feitas para o dia a dia, além das ocasiões formais." },
        { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Comprar agora" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Estilo do botão",
          "options": [
            { "value": "light", "label": "Claro" },
            { "value": "dark", "label": "Escuro" }
          ],
          "default": "light"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Posição do texto",
          "options": [
            { "value": "bottom-left", "label": "Inferior esquerda" },
            { "value": "bottom-center", "label": "Inferior centro" },
            { "value": "center", "label": "Centro" }
          ],
          "default": "bottom-left"
        },
        { "type": "color", "id": "text_color", "label": "Cor do texto", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [
    { "name": "Slideshow", "blocks": [{ "type": "slide" }, { "type": "slide" }] }
  ]
}
{% endschema %}
