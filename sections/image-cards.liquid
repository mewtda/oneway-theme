<section class="image-cards section-spacing">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        <h2 class="section-header__title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="image-cards__grid image-cards__grid--{{ section.settings.columns }}{% if section.settings.mobile_scroll %} image-cards__grid--scroll{% endif %}" style="--ratio: {{ section.settings.ratio }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_image = block.settings.image
          if card_image == blank and block.settings.collection
            assign card_image = block.settings.collection.featured_image
          endif
          assign card_title = block.settings.title
          if card_title == blank and block.settings.collection
            assign card_title = block.settings.collection.title
          endif
          assign card_url = block.settings.link
          if card_url == blank and block.settings.collection
            assign card_url = block.settings.collection.url
          endif
          assign sizes = '(min-width: 990px) 33vw, 90vw'
          if section.settings.columns == '2'
            assign sizes = '(min-width: 990px) 50vw, 90vw'
          elsif section.settings.columns == '4'
            assign sizes = '(min-width: 990px) 25vw, 50vw'
          endif
        -%}
        <div class="image-card image-card--{{ section.settings.text_position }}" {{ block.shopify_attributes }}>
          {%- if card_url != blank -%}<a href="{{ card_url }}" class="image-card__link">{%- else -%}<div class="image-card__link">{%- endif -%}
            <div class="image-card__media">
              {%- if card_image -%}
                {{ card_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1100, 1400, 1600', sizes: sizes, class: 'image-card__image' }}
              {%- else -%}
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'image-card__image placeholder' }}
              {%- endif -%}
            </div>
            <div class="image-card__content" style="--content-color: {{ section.settings.overlay_text_color }};">
              {%- if card_title != blank -%}
                <h3 class="image-card__title">{{ card_title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="image-card__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <span class="image-card__cta link-underline">{{ block.settings.button_label }}</span>
              {%- endif -%}
            </div>
          {%- if card_url != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cards de imagem",
  "class": "section-image-cards",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título" },
    {
      "type": "select",
      "id": "columns",
      "label": "Colunas no desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporção da imagem",
      "options": [
        { "value": "3 / 4", "label": "Retrato" },
        { "value": "1 / 1", "label": "Quadrado" },
        { "value": "4 / 3", "label": "Paisagem" },
        { "value": "16 / 9", "label": "Panorâmica" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Posição do texto",
      "options": [
        { "value": "below", "label": "Abaixo da imagem" },
        { "value": "overlay", "label": "Sobre a imagem" }
      ],
      "default": "below"
    },
    { "type": "color", "id": "overlay_text_color", "label": "Cor do texto sobre a imagem", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Rolagem horizontal no mobile", "default": true }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção", "info": "Preenche imagem, título e link automaticamente" },
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "text", "id": "text", "label": "Texto" },
        { "type": "text", "id": "button_label", "label": "Texto do link" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cards de imagem",
      "blocks": [
        { "type": "card", "settings": { "title": "Sobrecamisas", "text": "Peças versáteis para usar em camadas" } },
        { "type": "card", "settings": { "title": "Tricô", "text": "Malhas de inverno em cores com personalidade" } },
        { "type": "card", "settings": { "title": "Camisas", "text": "Escolhas inteligentes em novas estampas" } }
      ]
    }
  ]
}
{% endschema %}
