<section class="rich-text section-spacing" style="--section-bg: {{ section.settings.background }}; --section-text: {{ section.settings.text_color }};">
  <div class="page-width rich-text__inner rich-text__inner--{{ section.settings.alignment }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 class="rich-text__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}
          <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <a href="{{ block.settings.link | default: '#' }}" class="button" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Texto",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alinhamento",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    },
    { "type": "color", "id": "background", "label": "Fundo", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#000000" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Título",
      "settings": [{ "type": "text", "id": "heading", "label": "Título", "default": "Feito para durar" }]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [{ "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Conte a história da sua marca.</p>" }]
    },
    {
      "type": "button",
      "name": "Botão",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Saiba mais" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Texto", "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "button" }] }
  ]
}
{% endschema %}
