<section class="main-password">
  <div class="main-password__inner">
    <p class="site-header__logo-text">{{ shop.name }}</p>
    {%- if section.settings.heading != blank -%}
      <h1 class="page-title">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'sections.newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__field">
          <label for="PasswordNewsletter" class="visually-hidden">{{ 'sections.newsletter.email' | t }}</label>
          <input type="email" id="PasswordNewsletter" name="contact[email]" placeholder="{{ 'sections.newsletter.email' | t }}" required>
          <button type="submit" class="button">{{ 'sections.newsletter.subscribe' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="main-password__login">
      <summary class="link-underline">{{ 'templates.password.enter_with_password' | t }}</summary>
      {%- form 'storefront_password', class: 'newsletter__form' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="newsletter__field">
          <label for="Password" class="visually-hidden">{{ 'templates.password.password' | t }}</label>
          <input type="password" id="Password" name="password" placeholder="{{ 'templates.password.password' | t }}" autocomplete="current-password">
          <button type="submit" class="button">{{ 'templates.password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>

    <a href="https://www.mewtda.com.br" target="_blank" rel="noopener" class="site-footer__credits">
      <span>{{ 'sections.footer.developed_by' | t }}</span>
      <img src="{{ 'mewtda-logo.png' | asset_url }}" alt="Mewtda" width="87" height="28" loading="lazy">
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Senha",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Em breve" }
  ]
}
{% endschema %}
