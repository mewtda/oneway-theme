<section class="customer section-spacing">
  <div class="customer__inner">
    <h1 class="page-title">{{ 'customer.reset_password.title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'form' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="ResetPassword">{{ 'customer.login.password' | t }}</label>
        <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="ResetPasswordConfirm">{{ 'customer.reset_password.confirm' | t }}</label>
        <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--full">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Redefinir senha",
  "class": "section-main-reset-password"
}
{% endschema %}
