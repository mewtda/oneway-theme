{%- paginate search.results by 24 -%}
  <section class="main-search page-width section-spacing">
    <h1 class="page-title">{{ 'general.search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="main-search__form">
      <label for="SearchPage" class="visually-hidden">{{ 'general.search.title' | t }}</label>
      <input type="search" id="SearchPage" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
      <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      <p class="main-search__count">{{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
      {%- if search.results_count > 0 -%}
        <div class="product-grid product-grid--4">
          {%- for item in search.results -%}
            {%- case item.object_type -%}
              {%- when 'product' -%}
                {% render 'product-card', product: item %}
              {%- when 'article' -%}
                {% render 'article-card', article: item %}
              {%- when 'page' -%}
                <article class="search-page-result">
                  <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  <p>{{ item.content | strip_html | truncatewords: 20 }}</p>
                </article>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {% render 'pagination', paginate: paginate %}
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Busca",
  "class": "section-main-search"
}
{% endschema %}
