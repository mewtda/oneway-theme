<cart-drawer class="cart-drawer" id="CartDrawer" data-cart-type="{{ settings.cart_type }}" aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
    <div class="cart-drawer__header">
      <h2 id="CartDrawerTitle" class="cart-drawer__title">{{ 'sections.cart.title' | t }} ({{ cart.item_count }})</h2>
      <button type="button" class="site-header__icon" data-cart-close>
        {%- render 'icon', name: 'close' -%}
        <span class="visually-hidden">{{ 'general.close' | t }}</span>
      </button>
    </div>
    {%- if cart.item_count > 0 -%}
      {% render 'free-shipping-bar' %}
      <div class="cart-drawer__body">
        {% render 'cart-items' %}
        {% render 'cart-recommendations' %}
      </div>
      <div class="cart-drawer__footer">
        {% render 'cart-summary' %}
      </div>
    {%- else -%}
      {% render 'free-shipping-bar' %}
      <div class="cart-drawer__body">
        <div class="cart-drawer__empty">
          <p>{{ 'sections.cart.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'sections.cart.continue_shopping' | t }}</a>
        </div>
        {% render 'cart-recommendations' %}
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Carrinho lateral"
}
{% endschema %}
