<section class="list-collections page-width section-spacing">
  <h1 class="page-title">{{ 'collections.general.all_collections' | t }}</h1>
  <div class="image-cards__grid image-cards__grid--3" style="--ratio: 3 / 4;">
    {%- for collection in collections -%}
      <div class="image-card image-card--below">
        <a href="{{ collection.url }}" class="image-card__link">
          <div class="image-card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 33vw, 90vw', class: 'image-card__image' }}
            {%- else -%}
              {{ 'collection-apparel-1' | placeholder_svg_tag: 'image-card__image placeholder' }}
            {%- endif -%}
          </div>
          <div class="image-card__content">
            <h2 class="image-card__title">{{ collection.title }}</h2>
          </div>
        </a>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Lista de coleções",
  "class": "section-main-list-collections"
}
{% endschema %}
