<section class="customer section-spacing">
  <div class="customer__inner">
    <h1 class="page-title">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', class: 'form' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
        <input type="text" id="RegisterFirstName" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="field">
        <label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
        <input type="text" id="RegisterLastName" name="customer[last_name]" autocomplete="family-name">
      </div>
      <div class="field">
        <label for="RegisterEmail">{{ 'customer.login.email' | t }}</label>
        <input type="email" id="RegisterEmail" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="RegisterPassword">{{ 'customer.login.password' | t }}</label>
        <input type="password" id="RegisterPassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <label class="checkbox">
        <input type="checkbox" name="customer[accepts_marketing]">
        {{ 'customer.register.accepts_marketing' | t }}
      </label>
      <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Cadastro",
  "class": "section-main-register"
}
{% endschema %}
