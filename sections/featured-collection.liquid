{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}
<section class="featured-collection section-spacing">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.show_view_all -%}
      <div class="section-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-header__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.show_view_all and collection -%}
          <a href="{{ collection.url }}" class="link-underline">{{ 'sections.featured_collection.view_all' | t }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}{% if section.settings.mobile_scroll %} product-grid--scroll{% endif %}">
      {%- if collection and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <article class="product-card">
            <div class="product-card__media">
              {%- assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1 -%}
              {%- assign placeholder = 'product-apparel-' | append: placeholder_index -%}
              {{ placeholder | placeholder_svg_tag: 'product-card__image placeholder' }}
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title">{{ 'sections.featured_collection.placeholder_title' | t }}</h3>
              <div class="price"><span class="price__regular">{{ 19900 | money }}</span></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coleção em destaque",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "range", "id": "products_to_show", "label": "Quantidade de produtos", "min": 2, "max": 16, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Colunas no desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Rolagem horizontal no mobile", "default": false },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar \"Ver tudo\"", "default": true }
  ],
  "presets": [{ "name": "Coleção em destaque" }]
}
{% endschema %}
