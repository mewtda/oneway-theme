{%- assign blog = section.settings.blog -%}
<section class="blog-posts section-spacing">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-header__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if blog -%}
        <a href="{{ blog.url }}" class="link-underline">{{ 'sections.blog_posts.view_all' | t }}</a>
      {%- endif -%}
    </div>

    <div class="article-grid article-grid--scroll">
      {%- if blog and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: section.settings.post_limit -%}
          {% render 'article-card', article: article %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="article-card">
            <div class="article-card__media">{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}</div>
            <h3 class="article-card__title">{{ 'sections.blog_posts.placeholder_title' | t }}</h3>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Posts do blog",
  "class": "section-blog-posts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Journal" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "post_limit", "label": "Quantidade de posts", "min": 2, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Posts do blog" }]
}
{% endschema %}
