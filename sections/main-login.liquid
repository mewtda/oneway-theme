<section class="customer section-spacing">
  <div class="customer__inner">
    <div id="RecoverPassword" class="customer__panel" hidden>
      <h1 class="page-title">{{ 'customer.recover_password.title' | t }}</h1>
      <p>{{ 'customer.recover_password.subtext' | t }}</p>
      {%- form 'recover_customer_password', class: 'form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success">{{ 'customer.recover_password.success' | t }}</p>
        {%- endif -%}
        {{ form.errors | default_errors }}
        <div class="field">
          <label for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
          <input type="email" id="RecoverEmail" name="email" autocomplete="email" required>
        </div>
        <button type="submit" class="button button--full">{{ 'customer.recover_password.submit' | t }}</button>
        <a href="#login" class="link-underline" data-toggle-recover>{{ 'customer.recover_password.cancel' | t }}</a>
      {%- endform -%}
    </div>

    <div id="CustomerLogin" class="customer__panel">
      <h1 class="page-title">{{ 'customer.login.title' | t }}</h1>
      {%- form 'customer_login', class: 'form' -%}
        {{ form.errors | default_errors }}
        <div class="field">
          <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
          <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
        </div>
        {%- if form.password_needed -%}
          <div class="field">
            <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
            <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
          </div>
          <a href="#recover" class="link-underline" data-toggle-recover>{{ 'customer.login.forgot_password' | t }}</a>
        {%- endif -%}
        <button type="submit" class="button button--full">{{ 'customer.login.sign_in' | t }}</button>
        <a href="{{ routes.account_register_url }}" class="link-underline">{{ 'customer.login.create_account' | t }}</a>
      {%- endform -%}
    </div>

    {%- if shop.checkout.guest_login -%}
      <div class="customer__panel">
        <h2 class="section-header__title">{{ 'customer.login.guest_title' | t }}</h2>
        {%- form 'guest_login' -%}
          <button type="submit" class="button button--full">{{ 'customer.login.guest_continue' | t }}</button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Login",
  "class": "section-main-login"
}
{% endschema %}
