<section class="contact-form section-spacing">
  <div class="main-page__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-header__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- form 'contact', class: 'form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'templates.contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form__row">
        <div class="field">
          <label for="ContactName">{{ 'templates.contact.name' | t }}</label>
          <input type="text" id="ContactName" name="contact[{{ 'templates.contact.name' | t }}]" value="{{ form.name }}" autocomplete="name">
        </div>
        <div class="field">
          <label for="ContactEmail">{{ 'templates.contact.email' | t }} *</label>
          <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
        </div>
      </div>
      <div class="field">
        <label for="ContactPhone">{{ 'templates.contact.phone' | t }}</label>
        <input type="tel" id="ContactPhone" name="contact[{{ 'templates.contact.phone' | t }}]" value="{{ form.phone }}" autocomplete="tel">
      </div>
      <div class="field">
        <label for="ContactBody">{{ 'templates.contact.message' | t }}</label>
        <textarea id="ContactBody" name="contact[{{ 'templates.contact.message' | t }}]" rows="6">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="button">{{ 'templates.contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Formulário de contato",
  "class": "section-contact-form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Fale conosco" }
  ],
  "presets": [{ "name": "Formulário de contato" }]
}
{% endschema %}
